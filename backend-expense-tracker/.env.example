# Port used by the backend server
PORT=3000

# PostgreSQL database connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:TU_CONTRASENA@localhost:5432/expense_tracker?schema=public"

# Secret key used to sign and verify JWT authentication tokens
JWT_SECRET=una_clave_secreta_larga

# Time before a JWT token expires
# Examples: 1d = 1 day, 12h = 12 hours, 30m = 30 minutes
JWT_EXPIRES_IN=1d

# URL of the frontend application
# Used, for example, to configure CORS
FRONTEND_URL="http://localhost:5173"

# API key used to send emails through Resend
RESEND_API_KEY=re_your_resend_api_key_here